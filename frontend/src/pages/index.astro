---
import '../styles/global.css';
import MainApp from '../components/MainApp.svelte';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Link Extractor</title>

    <!-- Modern Vector Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fallback & Legacy Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />

    <!-- iOS Safari -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="LinkScope" />

    <!-- Web App Manifest & Theme -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0c14" />
  </head>
  <body>
    <MainApp client:load />
  </body>
</html>
